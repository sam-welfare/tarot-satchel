# Normalize text files to LF in the repository (Windows checkout still works for the game build).
* text=auto

*.cs   text eol=lf
*.csproj text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.py   text eol=lf

# Windows scripts: keep CRLF so they run in both Windows PowerShell and pwsh
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binaries
*.png  binary
*.jpg  binary
*.dll  binary
*.pck  binary
*.zip  binary
