# Build outputs
**/bin/
**/obj/
*.user
*.suo

# Mod build artifact (shipped via Releases, deployed locally by scripts/deploy.ps1)
TarotSatchel/bin/
TarotSatchel/obj/

# Temporary artifacts: screenshots, probes, one-off exports (see AGENTS.md section 3)
temp/

# Generated Steam Workshop workspace (contains the built DLL; regenerate with scripts/prepare-workshop.ps1)
workshop/upload/TarotSatchel/

# Local analysis tooling, not part of the mod
meta_dump/
api_dump/
pck_dump/
parse_pck.py
sim_pity.py

# Local game install / reference paths
.env
*.local

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Official ModUploader binaries (downloaded, not part of the mod)
workshop/upload/ModUploader*/

# ModUploader console log
workshop/upload/*.log
